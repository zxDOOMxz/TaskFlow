# Backend
DATABASE_URL=postgresql+psycopg2://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SECRET_KEY=change-me-to-a-long-random-string

# Supabase
SUPABASE_ENABLED=true
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# CORS (production domain + local dev)
CORS_ORIGINS=https://task-flow.work.gd,http://localhost:5173

# Web3Forms (optional)
WEB3FORMS_ENABLED=false
WEB3FORMS_ACCESS_KEY=

# Frontend build args
VITE_API_URL=/api/v1
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# MinIO (used only if SUPABASE_ENABLED=false)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=taskflow
