DATABASE_URL=postgresql+psycopg2://taskflow:taskflow@db:5432/taskflow
SECRET_KEY=change-me-in-production-super-secret-key-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=taskflow

# Supabase PostgreSQL example (free tier). Append ?sslmode=require to enforce SSL.
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# Web3Forms (https://web3forms.com/) for contact/invite forms
WEB3FORMS_ENABLED=false
WEB3FORMS_ACCESS_KEY=your-access-key
WEB3FORMS_ENDPOINT=https://api.web3forms.com/submit

# Supabase integration (Auth + PostgreSQL)
SUPABASE_ENABLED=false
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=your-jwt-secret
